# Referência para incorporar no config.toml de um ambiente Supabase CLI.
# NÃO é aplicado automaticamente nem substitui as demais configurações do projeto.
# No projeto hospedado, configurar e verificar a política pelo painel Auth.
[auth]
minimum_password_length = 12
password_requirements = "lower_upper_letters_digits_symbols"
enable_signup = false

[auth.email]
secure_password_change = true
